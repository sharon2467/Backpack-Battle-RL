+    if (len(items) != 26 or set(items) != expected or items['P:6']['item_index'] != 262
+            or items['P:7']['item_index'] != 23 or items['P:12']['item_index'] != 1 or items['O:9']['item_index'] != 19):
+        raise ValueError('captured joint exact26 subtype identities')
+    return True
