+def validate_captured_joint_fixture(fixture):
+    if type(fixture) is not dict or canonical_sha(fixture) != CAPTURED_JOINT_FIXTURE_SHA256:
+        raise ValueError('captured joint outside fixed26 Source fixture')
+    if any(type(side['character_class']) is not int or side['character_class'] != 0 for side in fixture['sides']):
