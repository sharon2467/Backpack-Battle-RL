+    if any(ready[field] > lineage[field] for field in ('starts', 'stops')):
+        raise ValueError('lifetime counter reset')
+    birth = _single_king_timer(lineage['birth'])
+    checkpoint = _single_king_timer(ready['state'])
+    current = _single_king_timer(fact['current'])
+    for snapshot in (birth, checkpoint, current):
+        node = snapshot['node']
+        if node['native_id'] != lineage['timer_id'] or node['name'] != 'InvulnerabilityTimer' or node['role'] not in (None, role):
+            raise ValueError('stable early native Timer identity')
+        if _single_king_real(snapshot['wait_time']['binary64_be']) <= 0 or _single_king_real(snapshot['time_left']['binary64_be']) < 0:
+            raise ValueError('native public Timer numeric domain')
+        if len(node['positions']) > CAPS['depth']:
+            raise ValueError('bounded early ancestry')
+        for name in ('role', 'path', 'name', 'class'):
+            if node[name] is not None and len(node[name].encode('utf-8')) > CAPS['string_utf8']:
+                raise ValueError('bounded early node text')
+    if birth['node']['inside_tree'] is not False or birth['node']['path'] is not None:
+        raise ValueError('actual first child outside tree')
+    if checkpoint['node']['inside_tree'] is not True or current['node']['inside_tree'] is not True or current['node']['role'] != role:
+        raise ValueError('ready/current selected in-tree Timer')
+    if any(not x['node']['path'].endswith('/InvulnerabilityTimer') for x in (checkpoint, current)):
+        raise ValueError('direct named Timer path')
+    # Counts and public states, including nonzero counts, are retained unchanged.
+    # Constructor seed / NO_START eligibility is a separate SOURCE recipe gate.
+    return fact
