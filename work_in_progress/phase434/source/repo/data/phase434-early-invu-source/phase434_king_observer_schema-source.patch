+            raise ValueError('early native identity')
+    if lineage['timer_id'] == lineage['owner_id']:
+        raise ValueError('Timer/owner alias')
+    if entry['owner_inside_tree'] is not True or type(entry['observer_ready_at_entry']) is not bool:
+        raise ValueError('actual entry readiness booleans')
+    scene = 'res://Core/Player.tscn' if role == 'invu:P' else 'res://Core/Opponent.tscn'
+    if entry['owner_script'] != 'res://Core/Character.gd' or entry['owner_scene'] != scene:
+        raise ValueError('fixed Character source domain')
+    if any(type(x['ordinal']) is not int or not 1 <= x['ordinal'] <= CAPS['native_ids'] * 2 for x in (entry, ready)) or entry['ordinal'] >= ready['ordinal']:
+        raise ValueError('ordered local entry/ready ordinals')
+    for phase in (lineage, ready):
