+    require(gate['input_witness']==PREPARED_WITNESS and gate['actual_same_instance'] is True,'actual gate witness/source association')
+    report=gate['gate'];view=gate['view']
+    require(type(report) is dict and report.get('schema')=='phase533-same-instance-prepared-business-gate/1' and report.get('status')=='PASS_PRE_ACTIVATION_SAME_INSTANCE','original observed gate status')
+    require(type(view) is dict and view.get('profile')==PROFILE and view.get('prepared') is True and view.get('activated') is False and view.get('king_mode') is False and view.get('king_states')=={},'captured zeroKing prepared gate stage')
+    for name in ('tape_position','tape_audit_length','passes_consumed'):
+        require(type(view.get(name)) is int and view[name]==0,'original gate before Tape/clock progress')
+    prepared=view['items']['P:14'];final=result['final']['items']['P:14'];item=bound['items']['P:14']
+    require(type(prepared['item_index']) is int and prepared['item_index']==199 and prepared['cache_prepared'] is True,'prepared Sapphire actual subtype')
+    require(type(final['item_index']) is int and final['item_index']==199 and final['instance_id']=='P:14' and type(item['item_index']) is int and item['item_index']==199,'same instance final/bound Sapphire subtype')
