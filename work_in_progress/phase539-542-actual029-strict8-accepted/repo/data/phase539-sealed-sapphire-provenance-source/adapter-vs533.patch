+def validate_sapphire_gate_origin(gate,result,bound,root_binding):
+    require(root_binding['prepare_gate']==PREPARE_GATE and root_binding['prepare_gate_canonical_sha256']==PREPARE_GATE_CANONICAL_SHA256 and root_binding['provenance_addendum']==PROVENANCE_ADDENDUM,'original gate/addendum binding')
