+			return fail("REGISTRY_ID_ROLE", "configure")
+		if registry[id].length() > CAPS.string_utf8 or registry[id].to_utf8().size() > CAPS.string_utf8:
+			return fail("ROLE_STRING_CAP", "configure")
+		roles_seen[registry[id]] = true
+		ids[id] = registry[id]
+	configured = true
+	return true
