+func write_record(channel, site, edge, subject, payload):
+	if failed or closed:
+		return false
+	if not CHANNEL_FILES.has(channel) or sequence >= CAPS.records:
+		return fail("RECORD_CAP_OR_CHANNEL", site)
+	var row = {"schema": "observer7-record/1", "sequence": sequence, "channel": channel, "site": site, "edge": edge, "subject": reference(subject), "stamp": stamp(), "payload": payload}
+	if estimated_bytes(row) > CAPS.record_bytes:
+		return fail("RECORD_PREALLOCATION_CAP", site)
+	var bytes = (JSON.print(row) + "\n").to_utf8()
+	if bytes.size() > CAPS.record_bytes or bytes.size() > CAPS.flush_bytes or total_bytes + bytes.size() > CAPS.total_bytes:
+		return fail("BYTE_CAP", site)
+	var filename = CHANNEL_FILES[channel]
+	var previous = file_sizes.get(filename, 0)
+	if previous + bytes.size() > CAPS.file_bytes:
+		return fail("FILE_BYTE_CAP", site)
+	var file = File.new()
+	var status = file.open(OUT.plus_file(filename), File.READ_WRITE if previous > 0 else File.WRITE)
+	if status != OK:
+		return fail("FILE_OPEN", site, status)
+	file.seek_end()
+	file.store_buffer(bytes)
+	file.flush()
+	var error = file.get_error()
+	file.close()
+	if error != OK:
+		return fail("FILE_WRITE", site, error)
+	file_sizes[filename] = previous + bytes.size()
+	total_bytes += bytes.size()
+	sequence += 1
+	return true
